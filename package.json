{
  "name": "llm-collab",
  "version": "0.1.0",
  "description": "Open-source CLI for AI-powered multi-agent collaboration, MCP integration, and autonomous workflows",
  "type": "module",
  "bin": {
    "llm-collab": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts --",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "cli",
    "ai",
    "multi-agent",
    "mcp",
    "llm",
    "claude",
    "orchestration"
  ],
  "author": "Rupam Bhattacharya",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.11",
    "@ai-sdk/openai": "^4.0.10",
    "@inquirer/prompts": "^8.5.2",
    "@linear/sdk": "^88.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/graphql": "^9.0.3",
    "@octokit/rest": "^22.0.1",
    "ai": "^7.0.19",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "express": "^5.2.1",
    "inquirer": "^12.6.0",
    "ora": "^8.2.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
